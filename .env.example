# Copy to .env and fill in. The server reads real environment variables;
# if you use a .env file, start it with: node --env-file=.env server/index.js
# (the "npm run start:env" / "npm run dev:env" scripts do exactly that).

# Use "production" on the real server: turns on HSTS and upgrade-insecure-requests.
NODE_ENV=development
PORT=3000

# Public address of the site. Stripe sends the customer back here after paying.
# In production it must start with https:// when Stripe is enabled.
PUBLIC_URL=http://localhost:3000

# ---- Database (PostgreSQL) ------------------------------------------------
# Connection string, for example postgres://user:password@localhost:5432/studio
# Leave empty to save to JSON files in STORAGE_DIR (local development only).
# The tables are created automatically on start (or with: npm run db:migrate).
DATABASE_URL=

# Cloud databases (Neon, Supabase, Render...) need an encrypted connection:
#   true       = encrypted and the certificate is checked (use this when it works)
#   no-verify  = encrypted, certificate not checked
#   false      = no encryption (local database)
DATABASE_SSL=false

# Maximum open connections to the database.
DATABASE_POOL_MAX=10

# Only used without DATABASE_URL: where the JSON files are saved.
STORAGE_DIR=./storage

# Maximum POST requests per minute from one IP address.
RATE_LIMIT_PER_MINUTE=10

# Number of reverse proxies in front of the app (Render, Railway, Nginx: 1).
# Keep 0 when running locally.
TRUST_PROXY=0

# ---- Stripe (test mode) ---------------------------------------------------
# Dashboard -> Developers -> API keys -> "Secret key" (starts with sk_test_).
# Leave empty to run without payments: the order dialog then says so.
STRIPE_SECRET_KEY=

# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# (starts with whsec_). Needed only to mark orders as paid via the webhook.
STRIPE_WEBHOOK_SECRET=
